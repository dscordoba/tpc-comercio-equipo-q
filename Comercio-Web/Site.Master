<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Presentacion.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%: Page.Title %> - COMERCIO </title>

        <asp:ContentPlaceHolder ID="head" runat="server">
        </asp:ContentPlaceHolder>

        <link href="~/Content/bootstrap.min.css" rel="stylesheet" runat="server" />
        <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    </head>

    <body class="bg-light">
        <form runat="server">
            <div class="d-flex" style="min-height: 100vh;">
            
                <!-- NAVBAR LATERAL (Sidebar) -->
                <div class="bg-dark text-white p-3 d-flex flex-column" style="width: 260px; min-width: 260px; min-height: 100vh;"> 
                    <div class="sidebar-brand d-flex align-items-center justify-content-center mb-4">
                        <div class="sidebar-brand-icon rotate-n-15 me-2 d-flex align-items-center">
                            <svg xmlns="http://w3.org" width="22" height="22" fill="currentColor" class="bi bi-building-fill text-white" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M3 0a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h3v-3.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V16h3a1 1 0 0 0 1-1V1a1 1 0 0 0-1-1zm1 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm-6 3A.5.5 0 0 1 4.5 5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm-6 3A.5.5 0 0 1 4.5 8h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm-6 3a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"/>
                            </svg>
                        </div>
                        <div class="sidebar-brand-text fw-bold tracking-wide text-uppercase text-white">COMERCIO</div>
                    </div>  
                    <hr class="text-white-50 my-2" />
                    <!-- Contenedor de Menú -->
                    <div class="flex-grow-1">
                        <ul class="nav flex-column gap-1">
                            <!-- SECCIÓN: HOME -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none" 
                                   runat="server" href="~/Default.aspx" role="button">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-house-door-fill me-2" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M6.5 14.5v-3.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5 .5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5"/>
                                        </svg>
                                        MENÚ PRINCIPAL
                                    </span>
                                </a>
                            </li>
                            <hr class="text-white-50 my-2" />
                            <span class="text-white-50 small text-uppercase fw-bold ps-2 d-block mb-1" style="font-size: 0.75rem;">Gestión</span>
                            <!-- SECCIÓN: ADMIN -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                   data-bs-toggle="collapse" href="#menuAdmin" role="button" aria-expanded="false" aria-controls="menuAdmin">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-gear-fill me-2" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.858 2.929 2.929 0 0 1 0 5.858z"/>
                                        </svg>
                                        ADMIN
                                    </span>
                                </a>
                                <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuAdmin">
                                    <ul class="nav flex-column small mt-1 gap-1">
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Admin/Usuarios">Gestión de usuarios</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Admin/Perfiles">Gestión de perfiles</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Admin/Tablas">Configuraciones</a></li>
                                    </ul>
                                </div>
                            </li>
                            <!-- SECCIÓN: INVENTARIO -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                   data-bs-toggle="collapse" href="#menuInventario" role="button" aria-expanded="false" aria-controls="menuInventario">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-box-seam-fill me-2" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M7.657 6.247c.11-.03.221-.046.343-.046.121 0 .233.016.343.046l5.982-1.646-.008-.031a1.2 1.2 0 0 0-.557-.743L8.57 1.026a1.2 1.2 0 0 0-1.14 0L2.234 3.873a1.2 1.2 0 0 0-.556.743l-.008.031zM1.5 5.593v6.54c0 .48.284.914.726 1.104l5.224 2.239V9.66zM8.5 15.476l5.224-2.239a1.2 1.2 0 0 0 .726-1.104v-6.54l-5.95 2.139v5.744z"/>
                                        </svg>
                                        INVENTARIO
                                    </span>
                                </a>
                                <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuInventario">
                                    <ul class="nav flex-column small mt-1 gap-1">
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Productos">Gestión de Productos</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Marcas">Gestión de Marcas</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Categorias">Gestión de Categorías</a></li>
                                    </ul>
                                </div>
                            </li>
                            <!-- SECCIÓN: COMPRAS -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                   data-bs-toggle="collapse" href="#menuCompras" role="button" aria-expanded="false" aria-controls="menuCompras">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-cart-check-fill me-2" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m-1.646-7.646-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8 8.293l2.646-2.647a.5.5 0 0 1 .708.708"/>
                                        </svg>
                                        COMPRAS
                                    </span>
                                </a>
                                <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuCompras">
                                    <ul class="nav flex-column small mt-1 gap-1">
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/NuevaCompra">Nueva Compra</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/Proveedores">Gestión de Proveedores</a></li>  
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/Informes">Informes</a></li>                                                            
                                    </ul>
                                </div>
                            </li>
                            <!-- SECCIÓN: VENTAS -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                   data-bs-toggle="collapse" href="#menuVentas" role="button" aria-expanded="false" aria-controls="menuVentas">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-cash-coin me-2" viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0"/>
                                            <path d="M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.472-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1h-.003zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195zM1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083q.088-.517.258-1H1V2h13v2.214q.54.2 1 .518V1a1 1 0 0 0-1-1z"/>
                                        </svg>
                                        VENTAS
                                    </span>
                                </a>
                                <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuVentas">
                                    <ul class="nav flex-column small mt-1 gap-1">
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/NuevaVenta">Nueva Venta (Facturación)</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/Clientes">Gestión de Clientes</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/Informes">Informes</a></li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="d-flex flex-column flex-grow-1 bg-light">
                    <!-- NAVBAR SUPERIOR (Topbar) -->
                    <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-4 mb-4" style="height: 70px;">
                        <ul class="navbar-nav ms-auto align-items-center gap-3">
                            <div class="topbar-divider d-none d-sm-block border-start h-100 mx-2" style="width: 1px; height: 2.5rem !important;"></div>
                            <li class="nav-item dropdown d-flex align-items-center">
                                <span class="me-2 d-none d-lg-inline text-secondary small fw-semibold">Usuario logueado</span>
                                <span class="d-flex align-items-center text-secondary">
                                    <svg xmlns="http://w3.org" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                    </svg>
                                </span>
                            </li>
                        </ul>
                    </nav>
                    <!-- CONTENIDO DE LA PÁGINA -->
                    <div class="container-fluid flex-grow-1 px-4">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                    <!-- FOOTER -->
                    <footer class="sticky-footer bg-white py-3 border-top mt-5">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span class="text-muted small">&copy; <%: DateTime.Now.Year %> <strong class="text-dark">Nuestra APP WEB</strong> Todos los derechos reservados.</span>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </form>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>
