<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Presentacion.SiteMaster" %>
<%@ Import Namespace="Negocio" %>

<!DOCTYPE html>
<html lang="es">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%: Page.Title %> - COMERCIO </title>

        <asp:ContentPlaceHolder ID="head" runat="server">
        </asp:ContentPlaceHolder>

        <link href="~/Content/bootstrap.min.css" rel="stylesheet" runat="server" />
        <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    </head>

    <body class="bg-light">
        <form runat="server">
            <div class="d-flex flex-column flex-md-row min-vh-100">
            
                <!-- NAVBAR LATERAL (Sidebar) -->
                <div class="bg-dark text-white p-3 d-flex flex-column col-12 col-md-auto" style="min-width: 260px;"> 
                    <div class="sidebar-brand d-flex align-items-center justify-content-center mb-4">
                        <div class="sidebar-brand-icon rotate-n-15 me-2 d-flex align-items-center">
                            <svg xmlns="http://w3.org" width="22" height="22" fill="currentColor" class="bi bi-shop me-2 text-primary" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.37 2.37 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0M1.5 8.5A.5.5 0 0 1 2 9v6h1v-5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v5h6V9a.5.5 0 0 1 1 0v6h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1V9a.5.5 0 0 1 .5-.5M4 15h3v-5H4zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zm3 0h-2v3h2z"/>
                            </svg>
                        </div>
                        <div class="sidebar-brand-text fw-bold tracking-wide text-uppercase text-white">COMERCIO</div>
                    </div>  
                    <hr class="text-white-50 my-1" />
                    <!-- Contenedor de Menú -->
                    <div class="flex-grow-1">
                        <ul class="nav flex-column gap-1">
                            <!-- SECCIÓN: HOME -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none" 
                                   runat="server" href="~/Default.aspx" role="button">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-house-door me-2 text-primary" viewBox="0 0 16 16">
                                            <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                                        </svg>
                                        MENÚ PRINCIPAL
                                    </span>
                                </a>
                            </li>
                            <li><hr class="text-white-50 my-2" /></li>
                            <li>
                                <span class="text-white-50 small text-uppercase fw-bold ps-2 d-block mb-1" style="font-size: 0.75rem;">Gestión</span>
                            </li>
                            <!-- SECCIÓN: ADMIN -->
                            <%-- Solo visible si es ADMIN --%>
                            <% if (Seguridad.esAdmin(Session["SessionActiva"])) { %>
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                       data-bs-toggle="collapse" href="#menuAdmin" role="button" aria-expanded="false" aria-controls="menuAdmin">
                                        <span class="d-flex align-items-center">
                                            <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-gear me-2 text-primary" viewBox="0 0 16 16">
                                                <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0"/>
                                                <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z"/>
                                            </svg>
                                            ADMIN
                                        </span>
                                    </a>
                                    <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuAdmin">
                                        <ul class="nav flex-column small mt-1 gap-1">
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Admin/Usuarios">Gestión de Usuarios</a></li>
                                        </ul>
                                    </div>
                                </li>
                                <!-- SECCIÓN: INVENTARIO -->
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                       data-bs-toggle="collapse" href="#menuInventario" role="button" aria-expanded="false" aria-controls="menuInventario">
                                        <span class="d-flex align-items-center">
                                            <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-box-seam me-2 text-primary" viewBox="0 0 16 16">
                                                <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/>
                                            </svg>
                                            INVENTARIO
                                        </span>
                                    </a>
                                    <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuInventario">
                                        <ul class="nav flex-column small mt-1 gap-1">
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Productos">Gestión de Productos</a></li>
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Marcas">Gestión de Marcas</a></li>
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Inventario/Categorias">Gestión de Categorías</a></li>
                                        </ul>
                                    </div>
                                </li>
                             
                                <!-- SECCIÓN: COMPRAS -->
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                       data-bs-toggle="collapse" href="#menuCompras" role="button" aria-expanded="false" aria-controls="menuCompras">
                                        <span class="d-flex align-items-center">
                                            <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-cart-check me-2 text-primary" viewBox="0 0 16 16">
                                                <path d="M11.354 6.354a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                                                <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                                            </svg>
                                            COMPRAS
                                        </span>
                                    </a>
                                    <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuCompras">
                                        <ul class="nav flex-column small mt-1 gap-1">
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/NuevaCompra">Nueva Compra</a></li>
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/Proveedores">Gestión de Proveedores</a></li>  
                                            <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Compras/Informes">Informes</a></li>                                                            
                                        </ul>
                                    </div>
                                </li>
                            <% } %>
                            <!-- SECCIÓN: VENTAS -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold p-2 d-flex align-items-center justify-content-between rounded text-decoration-none dropdown-toggle" 
                                   data-bs-toggle="collapse" href="#menuVentas" role="button" aria-expanded="false" aria-controls="menuVentas">
                                    <span class="d-flex align-items-center">
                                        <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-cash-coin me-2 text-primary" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0"/>
                                            <path d="M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195z"/>
                                            <path d="M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083q.088-.517.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1z"/>
                                            <path d="M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 6 6 0 0 1 3.13-1.567"/>
                                        </svg>
                                        VENTAS
                                    </span>
                                </a>
                                <div class="collapse ms-3 ps-2 border-start border-white-50" id="menuVentas">
                                    <ul class="nav flex-column small mt-1 gap-1">
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/NuevaVenta">Nueva Venta (Facturación)</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/Clientes">Gestión de Clientes</a></li>
                                        <li><a class="nav-link text-white-50 p-1 rounded" runat="server" href="~/Mod_Ventas/Informes">Informes</a></li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="d-flex flex-column flex-grow-1 bg-light w-100">
                    <!-- NAVBAR SUPERIOR (Topbar) -->
                    <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-3 px-md-4" style="min-height: 70px;">
                        <ul class="navbar-nav ms-auto align-items-center gap-3">
                            <li class="topbar-divider d-none d-sm-block border-start h-100 mx-2" style="width: 1px; height: 2.5rem !important;"></li>
        
                            <li class="nav-item d-flex align-items-center gap-2">
                                <asp:Label ID="lblUsuarioLogueado" runat="server" CssClass="d-none d-lg-inline text-secondary small fw-semibold" Text="Invitado"></asp:Label>
            
                                <span class="d-flex align-items-center text-secondary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                    </svg>
                                </span>
                                <asp:Button ID="btnCerrarSesion" runat="server" Text="Cerrar sesión" CssClass="btn btn-outline-danger btn-sm ms-2" OnClick="btnCerrarSesion_Click" Visible="false" />
                            </li>
                        </ul>
                    </nav>

                    <!-- CONTENIDO DE LA PÁGINA -->
                    <div class="container-fluid flex-grow-1 p-2 p-md-3" style="background-color: #dfe4eb">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                    <!-- FOOTER -->
                    <footer class="sticky-footer bg-white py-3 border-top mt-auto">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span class="text-muted small">&copy; <%: DateTime.Now.Year %> <strong class="text-dark">Nuestra APP WEB</strong> Todos los derechos reservados.</span>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </form>
        <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
        <script src='<%= ResolveUrl("~/Scripts/validaciones.js") %>'></script>
        <script type="text/javascript">
            document.addEventListener("keydown", function (event) {
                // Bloquea el Enter solo si el usuario está escribiendo dentro de una caja de texto (TextBox)
                if (event.key === "Enter" && event.target.tagName === "INPUT" && (event.target.type === "text" || event.target.type === "number" || event.target.type === "email")) {
                    event.preventDefault();
                }
            });
        </script>
    </body>
</html>
